{
    "name": "drawdy-sensemaker",
    "version": "0.1.0",
    "description": "Drawdy extension: sort, search and connect elements on board with Google's EmbeddingGemma 2",
    "author": "Phureewat A <a.phureewat@gmail.com>",
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "node build.ts",
        "test": "jest",
        "typecheck": "tsc --noEmit",
        "check": "node scripts/check.ts",
        "preview": "node scripts/preview.ts",
        "icons": "node scripts/icons.ts"
    },
    "devDependencies": {
        "@drawdy/driver-protocol": "latest",
        "@huggingface/transformers": "^4.3.1",
        "@jest/globals": "^30.5.2",
        "@rollup/plugin-typescript": "^12.1.2",
        "@swc/core": "^1.16.13",
        "@swc/jest": "^0.2.39",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24",
        "esbuild": "^0.28.2",
        "fflate": "^0.8.2",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "jsdom": "^30.1.2",
        "lucide-static": "^1.53.0",
        "rollup": "^4.34.0",
        "tslib": "^2.8.1",
        "typescript": "^5",
        "vite": "^8.2.1"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "<rootDir>/src/**/*.test.ts"
        ],
        "transform": {
            "^.+\\.ts$": [
                "@swc/jest",
                {
                    "jsc": {
                        "parser": {
                            "syntax": "typescript"
                        },
                        "target": "es2022"
                    },
                    "module": {
                        "type": "commonjs"
                    }
                }
            ]
        },
        "watchman": false
    }
}
